# Supabase — Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave service_role (Settings > API). Necessária enquanto não há login: sem ela
# o RLS bloqueia as gravações com "violates row-level security policy".
# Usada só no servidor — NUNCA use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google Gemini — https://aistudio.google.com/app/apikey
# Usada apenas no servidor (API routes). NEXT_PUBLIC_GEMINI_API_KEY também
# funciona, mas expõe a chave no navegador — prefira GEMINI_API_KEY.
GEMINI_API_KEY=AIzaSy...
